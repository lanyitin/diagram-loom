{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "diagram-loom",
  "version": "0.0.0",
  "identifier": "dev.diagramloom.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm run dev:web",
    "beforeBuildCommand": "pnpm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "diagram-loom",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src drawio: drawio://localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../vendor/drawio": "vendor/drawio"
    }
  }
}
